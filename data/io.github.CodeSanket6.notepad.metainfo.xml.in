<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.CodeSanket6.notepad</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Notepad</name>
  <summary>Windows 11 Fluent text editor for Linux</summary>
  <description>
    <p>
      An exact, pixel-aligned Windows 11 Notepad experience natively for Linux desktops.
      Features full Fluent design with Mica styling, native tab management, seamless client canvas,
      rich encoding support, search/replace, word wrap, and classic Windows keyboard shortcuts.
    </p>
  </description>
  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="11.2607.14.0" date="2026-10-31">
      <description>
        <p>Windows 11 Fluent design tabs, Mica styling, UTF-8/CRLF handling, and customizable theme settings.</p>
      </description>
    </release>
  </releases>
  <launchable type="desktop-id">io.github.CodeSanket6.notepad.desktop</launchable>
  <url type="homepage">https://github.com/CodeSanket6/notepad</url>
  <url type="bugtracker">https://github.com/CodeSanket6/notepad/issues</url>
  <url type="vcs-browser">https://github.com/CodeSanket6/notepad</url>
  <developer>
    <name>Sanket</name>
  </developer>
</component>
