{
  "app-id": "io.ninja.notepad",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "notepad",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=ipc",
    "--filesystem=host",
    "--talk-name=org.freedesktop.FileManager1"
  ],
  "modules": [
    {
      "name": "notepad",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
